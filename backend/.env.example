# InvestPro Backend Configuration
# Copy to .env and fill in values. Webull creds are NOT set here — they are
# entered in the Android app's Settings screen and pushed to /api/v1/setup.

# Master encryption key for per-user credential store. REQUIRED.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_MASTER_KEY=

# Path to SQLite credential database (matches the Docker / Fly.io volume mount)
CREDENTIALS_DB_PATH=/data/credentials.sqlite

# CORS — comma-separated list of origins allowed to call the API.
# Include the install landing page domain so the in-app webview works.
CORS_ALLOWED_ORIGINS=https://investpro.nhsindy.com

# Optional GLOBAL AI/research keys. Used only when a user hasn't supplied their own.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OCTAGON_API_KEY=

# Redis (defaults to docker-compose service name)
REDIS_URL=redis://redis:6379

# Optional Yahoo Finance proxy (for heavy rate limits)
YAHOO_FINANCE_PROXY=
