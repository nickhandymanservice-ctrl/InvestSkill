# InvestPro Backend Configuration
# Copy to .env and fill in your values

# Webull Trading (optional - enables live trading)
WEBULL_DEVICE_ID=
WEBULL_ACCESS_TOKEN=
WEBULL_REFRESH_TOKEN=
WEBULL_ACCOUNT_ID=

# Octagon MCP (optional - enables SEC filing research)
OCTAGON_API_KEY=

# AI/LLM (optional - enables enhanced AI responses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Proxy (optional - for Yahoo Finance rate limiting)
YAHOO_FINANCE_PROXY=

# Webshare rotating proxy (optional)
WEBSHARE_PROXY=
